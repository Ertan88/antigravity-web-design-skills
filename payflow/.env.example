# PayFlow — Firebase ve Google ile giriş ayarları.
# Bu dosyayı ".env" adıyla kopyalayıp değerleri doldur. (.env git'e eklenmez.)
# Bunlar gizli anahtar değildir; Firebase web yapılandırması uygulamaya gömülür.
# Güvenliği firestore.rules sağlar.

# Firebase Console → Proje ayarları → Genel → Uygulamalarınız → Web uygulaması → firebaseConfig
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google ile giriş (Google Cloud Console → API'ler ve Hizmetler → Kimlik bilgileri → OAuth istemci kimlikleri)
# Web istemcisi Firebase Authentication → Google sağlayıcısı açılınca otomatik oluşur.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
