{
  "expo": {
    "name": "Okul Yayın",
    "slug": "okul-pano",
    "scheme": "okulpano",
    "version": "1.6.4",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#f7f6f3",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {
      "bundleIdentifier": "com.okulpano.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Duyuru ve başarı fotoğrafı çekmek için kamera kullanılır.",
        "NSPhotoLibraryUsageDescription": "Duyuru ve başarı fotoğrafı seçmek için galeri kullanılır.",
        "NSCalendarsUsageDescription": "Nöbetlerinizi ve sınavları telefon takviminize eklemek için kullanılır.",
        "NSCalendarsFullAccessUsageDescription": "Nöbetlerinizi ve sınavları telefon takviminize eklemek için kullanılır."
      }
    },
    "android": {
      "package": "com.okulpano.app",
      "permissions": [
        "CAMERA",
        "POST_NOTIFICATIONS",
        "READ_CALENDAR",
        "WRITE_CALENDAR"
      ],
      "versionCode": 1016,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E5E66"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Okul Yayın",
      "shortName": "Okul Yayın",
      "themeColor": "#0E5E66",
      "backgroundColor": "#f7f6f3",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/plus-jakarta-sans/400Regular/PlusJakartaSans_400Regular.ttf",
            "./node_modules/@expo-google-fonts/plus-jakarta-sans/500Medium/PlusJakartaSans_500Medium.ttf",
            "./node_modules/@expo-google-fonts/plus-jakarta-sans/600SemiBold/PlusJakartaSans_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/plus-jakarta-sans/700Bold/PlusJakartaSans_700Bold.ttf",
            "./node_modules/@expo-google-fonts/plus-jakarta-sans/800ExtraBold/PlusJakartaSans_800ExtraBold.ttf"
          ]
        }
      ],
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0E5E66"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Duyuru ve başarı fotoğrafı çekmek için kamera kullanılır.",
          "photosPermission": "Duyuru ve başarı fotoğrafı seçmek için galeri kullanılır."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0E5E66"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Panoyu eşleştirmek için QR kodu okutmak ve fotoğraf çekmek için kamera kullanılır.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Nöbetlerinizi ve sınavları telefon takviminize eklemek için kullanılır."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "baseUrl": "/app"
    },
    "icon": "./assets/icon.png"
  }
}
