<?xml version="1.0" encoding="utf-8"?>
<!--
  Okul ağları (MEB) şifreli bağlantıları denetlemek için araya kendi sertifikasıyla girer. O sertifika TV'ye
  yüklendiyse (Ayarlar › Güvenlik › Sertifika yükle) pano uygulaması da onu tanır. Android 7'den sonra uygulamalar
  kullanıcının yüklediği sertifikaları kendiliğinden tanımadığı için burada açıkça izin verilir.
  Düz http (ör. okulun kendi sunucusu) önceki sürümdeki gibi açık kalır.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
