# Sunucu
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Üretimde mutlaka uzun ve rastgele bir değer verin: openssl rand -base64 48
JWT_SECRET=gelistirme-icin-degistirin-en-az-32-karakter-uzunlugunda

# Boş bırakılırsa gömülü PGlite (data/pglite) kullanılır. Üretimde PostgreSQL:
# DATABASE_URL=postgres://okulpano:sifre@localhost:5432/okulpano
DATABASE_URL=

# Yüklenen görsellerin klasörü
UPLOAD_DIR=./uploads

# Panelin dışarıdan erişilen adresi (çerez ve bağlantılar için)
PUBLIC_URL=http://localhost:5173

# E-posta (kayıt doğrulama, davet, deneme hatırlatması). Boşsa bağlantılar panelde gösterilir.
# Önerilen: Brevo HTTPS API (SMTP portu kapalı sunucularda da çalışır). Gönderen adres Brevo'da doğrulanmış olmalı.
# BREVO_API_KEY=xkeysib-...
# Ya da klasik SMTP:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=bildirim@okulunuz.k12.tr
# SMTP_PASS=
# SMTP_FROM=Panokul <bildirim@okulunuz.k12.tr>

# İlk kurulumda oluşturulacak platform yöneticisi (npm run seed)
SEED_SUPERADMIN_EMAIL=admin@okulpano.local
SEED_SUPERADMIN_PASSWORD=Pano2026!
